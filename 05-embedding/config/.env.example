# Azure subscription containing the AML workspace and Foundry account/project.
AZURE_SUBSCRIPTION_ID="<subscription-id>"

# Existing Azure Machine Learning workspace used to host the shared batch endpoint.
AML_RESOURCE_GROUP="<aml-resource-group>"
AML_WORKSPACE_NAME="<aml-workspace-name>"
AML_COMPUTE_NAME="<aml-compute-name>"
AML_ENDPOINT_NAME="<globally-unique-dual-model-batch-endpoint-name>"
AML_SMALL_DEPLOYMENT_NAME="<small-aml-deployment-name>"
AML_LARGE_DEPLOYMENT_NAME="<large-aml-deployment-name>"
AML_ADA_DEPLOYMENT_NAME="<ada-aml-deployment-name>"

# New Foundry account and project containing both embedding deployments.
FOUNDRY_RESOURCE_GROUP="<foundry-resource-group>"
FOUNDRY_ACCOUNT_NAME="<foundry-account-name>"
FOUNDRY_PROJECT_NAME="<foundry-project-name>"
FOUNDRY_PROJECT_ENDPOINT="https://<foundry-account-name>.services.ai.azure.com/api/projects/<foundry-project-name>"
AZURE_OPENAI_ENDPOINT="https://<foundry-account-name>.cognitiveservices.azure.com/openai/v1/"

# Deployment names can differ from model names; these defaults use matching names.
AZURE_OPENAI_SMALL_DEPLOYMENT="text-embedding-3-small"
AZURE_OPENAI_LARGE_DEPLOYMENT="text-embedding-3-large"
AZURE_OPENAI_ADA_DEPLOYMENT="text-embedding-ada-002-test"
AZURE_OPENAI_SMALL_MODEL="text-embedding-3-small"
AZURE_OPENAI_LARGE_MODEL="text-embedding-3-large"
AZURE_OPENAI_ADA_MODEL="text-embedding-ada-002"
AZURE_OPENAI_MODEL_VERSION="1"
AZURE_OPENAI_ADA_MODEL_VERSION="2"

# Foundry deployment settings used only when a requested deployment does not exist.
AZURE_OPENAI_SKU="GlobalStandard"
AZURE_OPENAI_CAPACITY="10"